<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        app:navigationIconTint="@android:color/white"
        app:title="@string/privacy_title"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textConsentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:textColor="@color/done_green"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#D0D3E0" />

            <TextView
                android:id="@+id/textTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Consent check boxes: hidden when the notice is only being viewed -->
    <LinearLayout
        android:id="@+id/consentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/checkPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/consent_privacy_checkbox"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/consent_terms_checkbox"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDecline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/decline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAgree"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="@string/agree_continue"
                app:backgroundTint="@color/agree_button_bg" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
